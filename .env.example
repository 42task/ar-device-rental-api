# Portainer Stack variables. Replace password placeholders before deployment.
RENTAL_API_IMAGE=hkccr.ccs.tencentyun.com/gdgeek/ar-device-rental-api:publish
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
RENTAL_SECRETS_DIR=/srv/ar-device-rental/secrets

PORT=8080
HOST=0.0.0.0
# Stack has one trusted Traefik hop and no published app port. For direct local
# development with no reverse proxy, set TRUST_PROXY=0.
TRUST_PROXY=1
PUBLIC_ORIGIN=https://d.4mr.cn
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ar_device_rental
MYSQL_USER=ar_rental
MYSQL_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_ROOT_PASSWORD
MYSQL_POOL_SIZE=10

# File paths are INSIDE the API container. Values may alternatively be supplied
# using JWT_SECRET / WECHAT_APP_SECRET; never commit real environment files.
JWT_SECRET=
JWT_SECRET_PATH=/run/secrets/jwt-secret
JWT_ISSUER=ar-device-rental-api
JWT_AUDIENCE=ar-device-rental-mini-program
WECHAT_APP_ID=wx03dbf50c15cac06f
WECHAT_APP_SECRET=
WECHAT_APP_SECRET_PATH=/run/secrets/wechat-app-secret

# Disabled means real login/device management can be tested without payment.
# It does not create simulated payments, refunds or active rentals.
WECHAT_PAY_ENABLED=0
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_API_V3_KEY_PATH=
# Platform certificate serial number OR WeChat Pay public-key ID (PUB_KEY_ID_*).
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
# Optional rotation map: JSON object from serial/key ID to PEM public key.
WECHAT_PAY_PLATFORM_KEYS_JSON=
RENTAL_CALLBACK_BASE_URL=https://d.4mr.cn/api/v2/rental
