!package.json
!package-lock.json
!tsconfig.json
!src/
!src/**
!scripts/
!scripts/**
!database/
!database/**
**/.env*
**/secrets/**
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.pfx
**/*.log
**/*.sql.gz
**/*.dump
