# Copy to apps/api/.env and enter your own random secrets. Never commit .env.
NODE_ENV=development
PORT=8080
HOST=127.0.0.1
TRUST_PROXY=0
PUBLIC_ORIGIN=http://127.0.0.1:8080
ADMIN_LOGIN_ENV_VERSION=develop
# Optional first-root bootstrap; accepts a verified mainland phone with/without +86.
# Quote spaced values in dotenv. Empty disables it; existing roots are not replaced.
ROOT_PHONE=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=33369
MYSQL_LOCAL_PORT=33369
MYSQL_DATABASE=ar_device_rental
MYSQL_USER=ar_rental
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_POOL_SIZE=10

# Three distinct random values: MYSQL_PASSWORD, MYSQL_ROOT_PASSWORD, JWT_SECRET.
# JWT_SECRET needs at least 32 bytes. One 'openssl rand -hex 32' per value works.
JWT_SECRET=
JWT_SECRET_PATH=
JWT_ISSUER=ar-device-rental-api
JWT_AUDIENCE=ar-device-rental-mini-program

WECHAT_APP_ID=wx03dbf50c15cac06f
WECHAT_APP_SECRET=
WECHAT_APP_SECRET_PATH=
WECHAT_PAY_ENABLED=0
RENTAL_CALLBACK_BASE_URL=https://d.4mr.cn/api/v2/rental
